{
  "name": "badminton-match-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_DEV=true vite dev",
    "dev:cf": "CLOUDFLARE_DEV=true vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:generate": "drizzle-kit generate --config ./db/drizzle.config.ts",
    "db:migrate": "wrangler -c ./wrangler.jsonc d1 migrations apply \"$D1_DATABASE_NAME\" --local",
    "db:migrate:remote": "wrangler -c ./wrangler.jsonc d1 migrations apply \"$D1_DATABASE_NAME\" --remote",
    "db:seed:admin": "bun run db/seeders/admin.ts --local",
    "db:seed:admin:remote": "bun run db/seeders/admin.ts --remote",
    "db:seed:halls": "bun run db/seeders/halls.ts --local",
    "db:seed:halls:remote": "bun run db/seeders/halls.ts --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/bun": "latest",
    "@types/jsdom": "latest",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "^0.31.10",
    "jsdom": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "postcss": "^8.5.15",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "packageManager": "bun@1.3.14"
}
