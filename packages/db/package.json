{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate -m ./migrations -j sql create",
    "seed:admin": "bun run seeders/admin.ts",
    "seed:halls": "bun run seeders/halls.ts"
  },
  "dependencies": {
    "better-auth": "^1.4.7",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@workspace/eslint-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
